# Copy to .env.local for local dev. Both values are public (they ship in the client bundle).
# CI reads them from GitHub repository variables with the same names.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Never put a secret/service_role key here.
VITE_SUPABASE_ANON_KEY=sb_publishable_...
